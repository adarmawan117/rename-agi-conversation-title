/* ==========================================================================
   ADR Prompt Manager - Ocean Dark Theme Stylesheet (QSS)
   Targeted for PyQt5 / Windows 10 & 11
   ========================================================================== */

QMainWindow, QWidget#CentralWidget {
    background-color: #0c1a3a;
    color: #bfdbfe;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 9.5pt;
}

QLabel#titleLabel {
    font-size: 13pt;
    font-weight: 700;
    color: #ffffff;
    font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif;
    letter-spacing: -0.2px;
}

QLabel#windowBadge {
    background-color: #172554;
    color: #60a5fa;
    border: 1px solid #1e3a8a;
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 7.5pt;
    font-weight: 600;
    font-family: 'JetBrains Mono', Consolas, monospace;
}

/* Cards & Content */
QFrame.card {
    background-color: #172554;
    border: 1px solid #1e3a8a;
    border-radius: 12px;
    padding: 12px;
}

QLabel {
    color: #bfdbfe;
    font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif;
}

QLabel#subtitleLabel {
    font-size: 8.5pt;
    color: #60a5fa;
    font-family: 'Inter', -apple-system, 'Segoe UI', sans-serif;
}

QLabel#sectionTitle {
    font-size: 9pt;
    font-weight: 600;
    color: #93c5fd;
    letter-spacing: 0.2px;
}

QLineEdit {
    background-color: #101e42;
    border: 1px solid #1e3a8a;
    border-radius: 8px;
    padding: 6px 10px;
    color: #dbeafe;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
    font-size: 9pt;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #13244f;
}

QLineEdit::placeholder {
    color: #3b82f6;
}

QLineEdit#monoInput {
    font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
    font-size: 8.5pt;
    color: #93c5fd;
}

QPushButton {
    background-color: #172554;
    border: 1px solid #1e3a8a;
    border-radius: 8px;
    color: #93c5fd;
    padding: 6px 14px;
    font-weight: 500;
    font-size: 9pt;
}

QPushButton:hover {
    background-color: #1e40af;
    border-color: #3b82f6;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton#primaryBtn {
    background-color: #2563eb;
    border: 1px solid #60a5fa;
    color: #ffffff;
    font-weight: 600;
    font-size: 9.5pt;
    padding: 8px 16px;
    border-radius: 8px;
}

QPushButton#primaryBtn:hover {
    background-color: #3b82f6;
    border-color: #93c5fd;
}

QPushButton#primaryBtn:pressed {
    background-color: #1d4ed8;
}

QPushButton#primaryBtn:disabled {
    background-color: #101e42;
    border-color: #172554;
    color: #2d456b;
}

QPushButton#dangerBtn {
    background-color: #2b111e;
    border: 1px solid #881337;
    color: #fca5a5;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 8px;
}

QPushButton#dangerBtn:hover {
    background-color: #3f1629;
    border-color: #be123c;
    color: #ffffff;
}

QTableWidget {
    background-color: #101e42;
    border: 1px solid #1e3a8a;
    border-radius: 8px;
    gridline-color: #14244d;
    color: #bfdbfe;
    selection-background-color: #1d4ed8;
    selection-color: #ffffff;
    font-size: 9pt;
}

QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #13244f;
}

QTableWidget::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #172554;
    color: #60a5fa;
    font-weight: 600;
    font-size: 8.5pt;
    padding: 7px;
    border: none;
    border-bottom: 2px solid #1e3a8a;
    border-right: 1px solid #13244f;
}

QScrollBar:vertical {
    background: #0c1a3a;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #1e3a8a;
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #2563eb;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QStatusBar {
    background-color: #081329;
    color: #60a5fa;
    border-top: 1px solid #172554;
    font-size: 8.5pt;
    padding-left: 8px;
}

QSizeGrip {
    background-color: transparent;
    width: 16px;
    height: 16px;
    margin-right: 4px;
    margin-bottom: 4px;
}

/* Dialogs & Popups (Dark Ocean Theme) */
QDialog, QMessageBox {
    background-color: #101e42;
    color: #dbeafe;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 9.5pt;
}

QMessageBox QLabel {
    color: #dbeafe;
    background-color: transparent;
    font-size: 9.5pt;
}

QMessageBox QPushButton {
    background-color: #172554;
    border: 1px solid #1e3a8a;
    border-radius: 8px;
    color: #93c5fd;
    font-weight: 600;
    font-size: 9pt;
    min-width: 72px;
    padding: 6px 16px;
}

QMessageBox QPushButton:hover {
    background-color: #1e40af;
    border-color: #3b82f6;
    color: #ffffff;
}

QMessageBox QPushButton:pressed {
    background-color: #1d4ed8;
}

QMessageBox QPushButton:default {
    background-color: #2563eb;
    border: 1px solid #60a5fa;
    color: #ffffff;
}

QMessageBox QPushButton:default:hover {
    background-color: #3b82f6;
    border-color: #93c5fd;
}
